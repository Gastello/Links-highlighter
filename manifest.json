{
  "manifest_version": 3,
  "name": "Links Highlighter",
  "description": "Inspect and highlight links, rel attributes, iframe content, and detectable JavaScript navigation.",
  "version": "1.0.0",
  "permissions": ["scripting", "storage", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vendor/tldts.min.js", "link-tools.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}